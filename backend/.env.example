# Backend Environment Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./workbench.db

# Production Neon PostgreSQL (Set in Render Dashboard - NEVER commit real credentials):
# Direct connection string from Neon dashboard (postgres:// or postgresql:// with sslmode=require)
# The application automatically normalizes this to postgresql+psycopg:// at runtime.
# DATABASE_URL=postgresql://<user>:<password>@<ep-id>.neon.tech/<dbname>?sslmode=require

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<your-vercel-app>.vercel.app
