# Contact Resolution Workbench - Environment Configuration
# Default local development uses SQLite
DATABASE_URL=sqlite:///./workbench.db

# Production Neon PostgreSQL example:
# Neon provides postgresql:// or postgres:// connection strings which the backend
# automatically normalizes to postgresql+psycopg:// without requiring manual edits.
# DATABASE_URL=postgresql://<user>:<password>@<ep-id>.neon.tech/<dbname>?sslmode=require

# Optional CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<your-vercel-app>.vercel.app

# Gemini AI Configuration (Backend only, never expose to frontend)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Admin credentials for the backend runtime only. Use a JSON service-account
# object in the deployment secret store; never commit a real credential.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase Web configuration (public values consumed by Vite).
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=...

CELERY_BROKER_URL=redis://localhost:6379/0

# Optional backend tracing; no telemetry service is needed for local development.
OBSERVABILITY_ENABLED=false
# OTEL_SERVICE_NAME=contact-resolution-workbench
# OBSERVABILITY_ENVIRONMENT=local
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Langfuse requires all three values. Set keys in the runtime secret store.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
